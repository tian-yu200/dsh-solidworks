{
  "schema_version": "1.0.0",
  "benchmark_name": "dsh-solidworks 2D-to-3D 规则机械件可复跑基准评测集",
  "updated_at": "2026-11-18",
  "description": "面向中小制造私企（非标自动化、机加工、钣金、工业3D打印）与专职CAD代画熟手场景构建的 2D-to-3D 基准评测清单。摒弃单纯追求『无人干预炫技生成率』，建立以『熟手人效比 (T_ai + T_edit) / T_human』与『特征树可编辑性（改主尺寸不连锁报错）』为双核心的客观工程评测体系。",
  "evaluation_policy": {
    "north_star_formula": "(t_ai_minutes + t_edit_minutes) / human_baseline_minutes",
    "commercial_viable_ratio_max": 0.50,
    "negative_roi_warning_ratio_min": 0.80,
    "require_editability_pass_for_commercial_ready": true,
    "bbox_tolerance_rule": "max(1.0 mm, 2.0%) per sorted axis (strict golden mode: ±0.5 mm)",
    "default_volume_tolerance_ratio": 0.02,
    "strict_volume_tolerance_ratio": 0.01,
    "require_single_solid_body": true
  },
  "category_taxonomy": {
    "bracket": {
      "label": "支架类",
      "typical_parts": "叉耳支架、U形支座、传感器安装架、带筋角码支座",
      "core_features": ["sketch", "extrude", "hole", "slot", "rib", "fillet", "chamfer"]
    },
    "shaft_flange": {
      "label": "轴套法兰类",
      "typical_parts": "阶梯轴、带扁位/键槽传动轴、端盖、法兰盘、衬套",
      "core_features": ["revolve", "extrude", "hole", "circular_pattern", "cosmetic_thread", "chamfer"]
    },
    "housing_valve": {
      "label": "座体箱体类",
      "typical_parts": "中小型阀体、脚踏座、轴承座、规则泵盖壳座",
      "core_features": ["sketch", "extrude", "revolve", "shell", "hole", "fillet", "cosmetic_thread"]
    },
    "plate_block": {
      "label": "板块连接件",
      "typical_parts": "异形多孔安装底板、高台支座、斜面定位垫块、工装治具块、扁平轮廓件",
      "core_features": ["box", "sketch", "extrude", "hole", "linear_pattern", "slot", "rounded_rect"]
    },
    "sheet_metal": {
      "label": "钣金件",
      "typical_parts": "U形电控折弯护罩、机箱安装托架、带边线法兰与腰形槽钣金件",
      "core_features": ["sheet_metal", "edge_flange", "sketched_bend", "extrude", "mirror"]
    }
  },
  "excluded_categories": [
    {
      "code": "freeform_surface",
      "label": "高阶自由曲面与外观造型件",
      "examples": "汽车A级曲面、汽轮机复杂扭曲叶片流道、人体工学鼠标外壳、卡通雕塑造物",
      "reason": "超出规则机械特征图（Feature Graph）确定性编译边界，强行承接会导致极高试错税与不可控重建报错。"
    },
    {
      "code": "drawingless_concept",
      "label": "无二维图纸输入的凭空概念设计",
      "examples": "一句话生成整台非标设备、无尺寸约束的工业创意发散",
      "reason": "本产品核心护城河为『有明确工程图纸输入的确定性核验翻模』，拒绝编造CAD工程尺寸与公差。"
    }
  ],
  "entry_schema": {
    "required_fields": [
      "id",
      "name",
      "category",
      "status",
      "difficulty",
      "drawing_paths",
      "expect_mm",
      "theoretical_volume_mm3",
      "dimension_ledger",
      "human_baseline_minutes",
      "editability_checks"
    ],
    "allowed_statuses": ["active", "pending_retest", "reserved_slot"],
    "allowed_difficulties": ["simple", "medium", "complex"]
  },
